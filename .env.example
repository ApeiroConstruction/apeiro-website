# Copy this file to .env.local for local testing, and add the same names in
# Vercel > Project > Settings > Environment Variables. Never commit real values.

# Public site address (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.apeiroconstruction.com

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# Supabase (Project Settings > API). The service role key is secret: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email notifications for new quote requests)
RESEND_API_KEY=
QUOTE_NOTIFY_TO=info@apeiroconstruction.com
QUOTE_NOTIFY_FROM=Apeiro Website <website@apeiroconstruction.com>
